# Configuration générale
DEBUG=True
SECRET_KEY=django-insecure-change-me-in-production-comptage-paoma-2026
ALLOWED_HOSTS=localhost,127.0.0.1

# Base de données PostgreSQL (format URL)
# Exemple avec socket unix local : postgresql://comptage_user:12345678@localhost:5432/comptage_dev
DATABASE_URL=postgresql://comptage_user:12345678@localhost:5432/comptage_dev

# CORS - Origine autorisée du client React (Vite)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
