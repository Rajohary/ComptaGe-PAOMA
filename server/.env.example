# Configuration générale
DEBUG=True
SECRET_KEY=django-insecure-change-me-in-production-comptage-paoma-2026
ALLOWED_HOSTS=localhost,127.0.0.1

# Base de données PostgreSQL (format URL)
# Exemple avec socket unix local : postgresql://comptage_user:comptage_password@localhost:5432/comptage_db
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/comptage_db

# CORS - Origine autorisée du client React (Vite)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
